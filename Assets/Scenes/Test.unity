--- !u!114 &73806038
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 73806036}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce56339215454a24aa9b872049fbae61, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameController
  Board: {fileID: 215633117}
  DiceManager: {fileID: 1940097463}
  realMurderer: 
  realWeapon: 
  realRoom: 
  clueCardDeck:
  - CardName: Kitchen Showdown
    PromptText: Choose a player. If they possess the KITCHEN card, they must show
      it to you.
  - CardName: Revolver Reveal
    PromptText: Select an opponent. If they hold the REVOLVER card, they are required
      to reveal it to you.
  - CardName: Mr. Green's Appearance
    PromptText: Identify a player. They must show you the MR. GREEN card if it is
      in their hand.
  - CardName: Passage Trade
    PromptText: Choose one card from your hand and trade it with a random card from
      the adjacent player to your right.
  - CardName: Double Dealer
    PromptText: Pick two opponents. They must each choose one card from their hand
      and swap it with the other player.
  - CardName: Secret Swap
    PromptText: Choose two players (other than yourself). They are forced to trade
      one random card with each other.
  - CardName: Group Reveal
    PromptText: All players (including you) must choose one card from their hand
      and show it simultaneously to everyone.
  - CardName: Group Reveal
    PromptText: Each player selects one card of their choice and reveals it to all
      other players at the table.
  - CardName: The Lineup
    PromptText: All players must temporarily reveal one of their Suspect cards to
      the group.
  - CardName: Quick Turn
    PromptText: Your turn doesn't end. You immediately take another full turn.
  - CardName: Lucky Die
    PromptText: On your very next turn, you add a bonus of +2 to whatever you roll
      on the dice.
  - CardName: Forced Relocation
    PromptText: Select any player and move them from their current location to any
      adjacent room.
  - CardName: Detained
    PromptText: You are trapped in your current room. You cannot move out of it for
      one full turn.
  - CardName: Top Secret
    PromptText: You may look at the card that is currently sitting on top of the
      discard pile.
  - CardName: Protection
    PromptText: If you make a false accusation on your next turn, you are immune
      to any penalty.
  - CardName: Uncontested Idea
    PromptText: Your next suggestion will automatically be considered 'confirmed'
      if no one shows you a card.
  - CardName: Room Collector
    PromptText: The player holding the highest number of Room cards must reveal one
      of them to you.
  - CardName: Suspect Hound
    PromptText: The player currently holding the most Suspect cards must reveal one
      of them to you.
  - CardName: Suspect Hound
    PromptText: Identify who has the largest number of Suspect cards. They must show
      you one.
  - CardName: Delayed Truth
    PromptText: The next player must take one of their cards and place it face-down.
      It's revealed at the end of the round.
  - CardName: Double Suggestion
    PromptText: In a single turn, you are permitted to make two suggestions, provided
      they are in two different rooms.
